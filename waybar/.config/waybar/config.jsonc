{
  "layer": "top",
  "position": "left",
  "output": "DP-1",
  "exclusive": true,
  "passthrough": false,
  "width": 36,
  "margin": "20 0 20 20",

  /* === Modules Order === */
  "modules-left": [
    "custom/icon",
    "clock",
    "cpu",
    "temperature",
    "disk"
  ],

  "modules-center": [
    "wlr/taskbar"
  ],

  "modules-right": [
    "battery",
    "pulseaudio",
    "sway/language"
  ],

  /* === Modules === */
  "custom/icon": {
    "format": " ",
    "tooltip-format": "Rofi App Launcher",
    "on-click": "/home/gaia/.config/rofi/rofi-with-mask -show drun -terminal ghostty -kb-cancel Escape"
  },

  "memory": {
    "format": "{}% 󰍛",
    "rotate": 90,
    "tooltip": true
  },

  "cpu": {
    "format": "{usage}% ",
    "rotate": 90,
    "tooltip": true
  },

  "temperature": {
    "format": "{temperatureC}°C {icon}",
    "rotate": 90,
    "tooltip": true,
    "format-icons": [
      ""
    ]
  },

  "disk": {
    "format": "{specific_free:0.0f} GB ",
    "unit": "GB",
    "rotate": 90,
    "tooltip": true
  },

  "clock": {
    "align": 0.5,
    "justify": "center",
    "format": "{:%H\n%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "all-outputs": true,
    "tooltip-format": "{name}",
    "on-click": "activate",
    "on-click-middle": "close",
    "icon-size": 24,
    "ignore-list": [
      "rofi"
    ]
  },

  "battery": {
    "bat": "BAT0",
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "format-charging": "{capacity}%  ",
    "rotate": 90,
    "tooltip-format": "Battery: {capacity}%\nTime left: {time}",
    "tooltip-format-charging": "Battery: {capacity}%\nTime to full: {time}"
  },

  "pulseaudio": {
    "format": "{volume}% ",
    "format-muted": " MUTE",
    "rotate": 90,
    "on-click": "",
    "tooltip": false
  },

  "sway/language": {
    "format": "{} ",
    "rotate": 90,
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
    "format-fr": "FR",
    "format-en": "ENG"
  }
}
